<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: MAUI's generated layers plus our own monochrome layer for Android 13+ themed icons (MAUI
     would reuse the coloured foreground, where the sun and cloud merge into one shape). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/appicon_background" />
    <foreground android:drawable="@mipmap/appicon_foreground" />
    <monochrome android:drawable="@drawable/appicon_monochrome" />
</adaptive-icon>
