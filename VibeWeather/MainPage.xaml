<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VibeWeather"
             xmlns:components="clr-namespace:VibeWeather.Components"
             x:Class="VibeWeather.MainPage"
             SafeAreaEdges="Container"
             BackgroundColor="{AppThemeBinding Light=#F1EFEA, Dark=#0E1013}">

    <Grid>
        <!-- Android's splash sun, kept in place behind the (transparent) WebView until index.html paints its start
             screen over it, so the sun never blinks out. Same 288 dp box as the system splash icon. -->
        <Image x:Name="splashSun" Source="vw_splash_sun.png" WidthRequest="288" HeightRequest="288"
               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html"
                       BlazorWebViewInitialized="OnBlazorWebViewInitialized">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
